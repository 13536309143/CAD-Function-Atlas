# Configure ONE provider. Copy selected values into .env; never commit credentials.
# MiniMax remains the default if LLM_PROVIDER is omitted.
LLM_PROVIDER=openai_responses
LLM_MODEL=replace_with_your_available_vision_model_id
OPENAI_API_KEY=replace_with_your_openai_api_key
LLM_MAX_OUTPUT_TOKENS=2048

# Claude: LLM_PROVIDER=anthropic, LLM_MODEL=<vision model>, ANTHROPIC_API_KEY=<key>
# Gemini: LLM_PROVIDER=gemini, LLM_MODEL=<vision model>, GEMINI_API_KEY=<key>
# OpenAI Chat Completions: LLM_PROVIDER=openai_chat
# Compatible services: LLM_PROVIDER=openai_compatible, LLM_MODEL=<vision model>
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=replace_with_your_compatible_api_key
# LLM_API_KEY overrides the selected vendor-specific key only when nonempty.
